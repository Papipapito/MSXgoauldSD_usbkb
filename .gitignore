test_hw/

# Headless Gowin build helper + logs (the IDE build uses Z80_goauld.gprj)
fpga/build_kbd.tcl

# Gowin headless build outputs (project.* — IDE outputs are Z80_goauld.*)
fpga/impl/pnr/project.*
fpga/impl/pnr/project_*
fpga/impl/gwsynthesis/project.*
fpga/impl/gwsynthesis/project_*

# Build logs
*_log.txt
*.log

# production/: the .uf2 and .fs ARE committed; never the copyrighted MSX BIOS
# pack or the debug ELF.
production/goauld_rom_int.bin
production/*.elf
